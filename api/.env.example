APP_NAME=MEDISCOPE
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://mediscope:replace-me@localhost:5432/mediscope
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
