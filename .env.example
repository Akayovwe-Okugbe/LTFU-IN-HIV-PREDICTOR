# =========================================================
# MEDISCOPE ENVIRONMENT CONFIGURATION EXAMPLE
#
# Copy this file to:
#
#     .env
#
# for local development and replace placeholder values.
#
# Never commit the real .env file.
# =========================================================


# =========================================================
# APPLICATION
# =========================================================

APP_NAME=MEDISCOPE

# Supported:
# development
# testing
# production
ENVIRONMENT=development

DEBUG=false

FRONTEND_BASE_URL=http://localhost:5173


# =========================================================
# POSTGRESQL DATABASE
# =========================================================

DATABASE_URL=postgresql+psycopg://mediscope:replace-me@localhost:5432/mediscope


# =========================================================
# DOCKER / POSTGRESQL SERVICE
# =========================================================

POSTGRES_DB=mediscope
POSTGRES_USER=mediscope
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432


# =========================================================
# JWT ACCESS TOKENS
# =========================================================

# Replace with a cryptographically random value.
# Do not reuse development secrets in production.
SECRET_KEY=replace-with-a-long-random-secret-of-at-least-32-characters

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30


# =========================================================
# REFRESH TOKENS
# =========================================================

REFRESH_TOKEN_EXPIRE_DAYS=7


# =========================================================
# PASSWORD POLICY
# =========================================================

PASSWORD_MIN_LENGTH=12


# =========================================================
# EMAIL VERIFICATION
# =========================================================

OTP_EXPIRE_MINUTES=10

OTP_MAX_ATTEMPTS=5


# =========================================================
# PASSWORD RESET
# =========================================================

PASSWORD_RESET_EXPIRE_MINUTES=20


# =========================================================
# MULTI-FACTOR AUTHENTICATION
# =========================================================

# Generate a dedicated key with:
#
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Never reuse SECRET_KEY here.
TOTP_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

TOTP_ISSUER_NAME=MEDISCOPE

MFA_CHALLENGE_EXPIRE_MINUTES=5

MFA_RECOVERY_CODE_COUNT=10


# =========================================================
# EMAIL DELIVERY
# =========================================================

EMAIL_FROM=noreply@example.com

# Development:
# true prints authentication emails to the server console.
#
# Production:
# this must be false.
EMAIL_CONSOLE_BACKEND=true

SMTP_HOST=

SMTP_PORT=587

SMTP_USERNAME=

SMTP_PASSWORD=

SMTP_USE_TLS=true


# =========================================================
# DATA GOVERNANCE
# =========================================================

# This capstone prototype must remain synthetic-data only.
SYNTHETIC_DATA_ONLY=true


# =========================================================
# MACHINE-LEARNING MODELS
# =========================================================

LOGISTIC_MODEL_PATH=models/trained/logistic_regression_pipeline.joblib

XGBOOST_MODEL_PATH=models/trained/xgboost_pipeline.joblib

DECISION_THRESHOLD=0.50
